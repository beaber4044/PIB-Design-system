{
  "$description": "Mobile app tokens (iOS/Android) — same brand as web, expressed in dp/sp for native + Figma import.",
  "color": {
    "brand": {
      "50": { "$type": "color", "$value": "#e6f9ee" },
      "100": { "$type": "color", "$value": "#c2f0d7" },
      "200": { "$type": "color", "$value": "#8fe3b3" },
      "300": { "$type": "color", "$value": "#5cd68f" },
      "400": { "$type": "color", "$value": "#22cf6c" },
      "500": { "$type": "color", "$value": "#03c75a" },
      "600": { "$type": "color", "$value": "#02b350" },
      "700": { "$type": "color", "$value": "#029245" },
      "800": { "$type": "color", "$value": "#027238" },
      "900": { "$type": "color", "$value": "#01522a" }
    },
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#f8f8fa" },
      "100": { "$type": "color", "$value": "#f0f0f3" },
      "200": { "$type": "color", "$value": "#e2e2e8" },
      "300": { "$type": "color", "$value": "#c7c7d1" },
      "400": { "$type": "color", "$value": "#9d9dac" },
      "500": { "$type": "color", "$value": "#74748a" },
      "600": { "$type": "color", "$value": "#56566b" },
      "700": { "$type": "color", "$value": "#3d3d4d" },
      "800": { "$type": "color", "$value": "#262633" },
      "900": { "$type": "color", "$value": "#16161f" },
      "950": { "$type": "color", "$value": "#0a0a0f" }
    },
    "success": {
      "50": { "$type": "color", "$value": "#ecfdf5" },
      "500": { "$type": "color", "$value": "#10b981" },
      "700": { "$type": "color", "$value": "#047857" }
    },
    "warning": {
      "50": { "$type": "color", "$value": "#fffbeb" },
      "500": { "$type": "color", "$value": "#f59e0b" },
      "700": { "$type": "color", "$value": "#b45309" }
    },
    "danger": {
      "50": { "$type": "color", "$value": "#fef2f2" },
      "500": { "$type": "color", "$value": "#ef4444" },
      "700": { "$type": "color", "$value": "#b91c1c" }
    },
    "info": {
      "50": { "$type": "color", "$value": "#eff6ff" },
      "500": { "$type": "color", "$value": "#3b82f6" },
      "700": { "$type": "color", "$value": "#1d4ed8" }
    }
  },
  "font": {
    "family": {
      "ios": { "$type": "fontFamily", "$value": ["Naver Sans", "Apple SD Gothic Neo", "-apple-system"] },
      "android": { "$type": "fontFamily", "$value": ["Naver Sans", "NanumSquare", "Roboto"] }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "12sp" },
      "footnote": { "$type": "dimension", "$value": "13sp" },
      "body": { "$type": "dimension", "$value": "15sp" },
      "subhead": { "$type": "dimension", "$value": "17sp" },
      "title3": { "$type": "dimension", "$value": "19sp" },
      "title2": { "$type": "dimension", "$value": "22sp" },
      "title1": { "$type": "dimension", "$value": "26sp" },
      "largeTitle": { "$type": "dimension", "$value": "32sp" }
    }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "4dp" },
    "sm": { "$type": "dimension", "$value": "6dp" },
    "md": { "$type": "dimension", "$value": "8dp" },
    "lg": { "$type": "dimension", "$value": "12dp" },
    "xl": { "$type": "dimension", "$value": "16dp" },
    "full": { "$type": "dimension", "$value": "9999dp" }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "4dp" },
    "sm": { "$type": "dimension", "$value": "8dp" },
    "md": { "$type": "dimension", "$value": "16dp" },
    "lg": { "$type": "dimension", "$value": "24dp" },
    "xl": { "$type": "dimension", "$value": "32dp" },
    "2xl": { "$type": "dimension", "$value": "48dp" }
  },
  "elevation": {
    "level0": { "$type": "shadow", "$value": { "color": "#00000000", "offsetX": "0dp", "offsetY": "0dp", "blur": "0dp", "spread": "0dp" } },
    "level1": { "$type": "shadow", "$value": { "color": "#1010101a", "offsetX": "0dp", "offsetY": "1dp", "blur": "3dp", "spread": "0dp" } },
    "level2": { "$type": "shadow", "$value": { "color": "#1010101f", "offsetX": "0dp", "offsetY": "2dp", "blur": "6dp", "spread": "0dp" } },
    "level3": { "$type": "shadow", "$value": { "color": "#10101026", "offsetX": "0dp", "offsetY": "6dp", "blur": "12dp", "spread": "0dp" } }
  },
  "size": {
    "touchTarget": { "$type": "dimension", "$value": "44dp" },
    "tabBarHeight": { "$type": "dimension", "$value": "56dp" },
    "navBarHeight": { "$type": "dimension", "$value": "48dp" }
  }
}
